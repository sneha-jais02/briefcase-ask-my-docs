# This protects access to your local app; it is not an AI provider API key.
API_KEY=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-different-long-random-secret
BOOTSTRAP_WORKSPACE_NAME=Local legal workspace
BOOTSTRAP_ADMIN_EMAIL=admin@localhost.local
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-password-of-at-least-12-characters
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
# Select "openai" or "gemini"; configure the matching provider key below.
LLM_PROVIDER=openai
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
